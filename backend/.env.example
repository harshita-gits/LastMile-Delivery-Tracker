# PostgreSQL connection string (Render/Railway/local)
DATABASE_URL="postgresql://user:password@localhost:5432/lastmile_delivery?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Email (Gmail App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="16-char-app-password"
SMTP_FROM="Last-Mile Delivery <youraddress@gmail.com>"

# Admin bootstrap (used by seed script)
ADMIN_EMAIL="admin@lastmile.com"
ADMIN_PASSWORD="Admin@123"
