// ==========================================================
// Last-Mile Delivery Tracker — Prisma Schema
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum OrderType {
  B2B
  B2C
}

enum PaymentType {
  PREPAID
  COD
}

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
}

enum AgentAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

// ---------------- Core Models ----------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  // relations
  agentProfile      Agent?
  ordersAsCustomer  Order[]         @relation("CustomerOrders")
  ordersCreated     Order[]         @relation("CreatedByAdmin")
  statusChangesMade OrderStatusHistory[] @relation("ActorUser")

  @@map("users")
}

// A delivery agent is a User with role=AGENT plus operational fields.
model Agent {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id])
  currentZoneId    String?
  currentZone      Zone?             @relation(fields: [currentZoneId], references: [id])
  availability     AgentAvailability @default(AVAILABLE)
  createdAt        DateTime          @default(now())

  orders           Order[]           @relation("AssignedAgent")

  @@map("agents")
}

// A Zone is an admin-defined logical delivery area (e.g. "Zone-North-Bengaluru").
model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  city      String?
  createdAt DateTime @default(now())

  areas          ZoneArea[]
  agents         Agent[]
  ordersPickup   Order[]      @relation("PickupZone")
  ordersDrop     Order[]      @relation("DropZone")
  rateCardsFrom  RateCard[]   @relation("FromZone")
  rateCardsTo    RateCard[]   @relation("ToZone")

  @@map("zones")
}

// Maps a pincode (or area/locality string) to a Zone — this is the basis of zone detection.
model ZoneArea {
  id       String @id @default(uuid())
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id])
  pincode  String @unique
  areaName String?

  @@index([pincode])
  @@map("zone_areas")
}

// Rate card: rate for shipping FROM one zone TO another zone, for a given order type.
// Intra-zone rate = row where fromZoneId == toZoneId.
model RateCard {
  id            String    @id @default(uuid())
  fromZoneId    String
  fromZone      Zone      @relation("FromZone", fields: [fromZoneId], references: [id])
  toZoneId      String
  toZone        Zone      @relation("ToZone", fields: [toZoneId], references: [id])
  orderType     OrderType
  baseRatePerKg Decimal   @db.Decimal(10, 2) // ₹ per kg (billable weight)
  minCharge     Decimal   @db.Decimal(10, 2) // floor charge regardless of weight
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([fromZoneId, toZoneId, orderType])
  @@map("rate_cards")
}

// COD surcharge config, configurable per order type (B2B/B2C). Flat fee + percentage, admin sets both (either can be 0).
model CodSurchargeConfig {
  id           String    @id @default(uuid())
  orderType    OrderType @unique
  flatFee      Decimal   @db.Decimal(10, 2) @default(0)
  percentOfCharge Decimal @db.Decimal(5, 2) @default(0) // e.g. 2.00 = 2%
  updatedAt    DateTime  @updatedAt

  @@map("cod_surcharge_configs")
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique // human-readable e.g. LMD-000123

  // parties
  customerId        String
  customer          User        @relation("CustomerOrders", fields: [customerId], references: [id])
  createdByAdminId  String?
  createdByAdmin    User?       @relation("CreatedByAdmin", fields: [createdByAdminId], references: [id])

  // addresses
  pickupAddress     String
  pickupPincode     String
  dropAddress       String
  dropPincode       String

  pickupZoneId      String?
  pickupZone        Zone?       @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropZoneId        String?
  dropZone          Zone?       @relation("DropZone", fields: [dropZoneId], references: [id])

  // package
  lengthCm          Decimal     @db.Decimal(8, 2)
  breadthCm         Decimal     @db.Decimal(8, 2)
  heightCm          Decimal     @db.Decimal(8, 2)
  actualWeightKg    Decimal     @db.Decimal(8, 3)
  volumetricWeightKg Decimal    @db.Decimal(8, 3)
  billableWeightKg  Decimal     @db.Decimal(8, 3)

  orderType         OrderType
  paymentType       PaymentType

  // charge breakdown (all persisted for auditability — never recompute silently later)
  baseCharge        Decimal     @db.Decimal(10, 2)
  codSurcharge      Decimal     @db.Decimal(10, 2) @default(0)
  totalCharge       Decimal     @db.Decimal(10, 2)

  status            OrderStatus @default(CREATED)

  assignedAgentId   String?
  assignedAgent     Agent?      @relation("AssignedAgent", fields: [assignedAgentId], references: [id])

  rescheduledDate   DateTime?
  failureReason     String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  statusHistory     OrderStatusHistory[]

  @@index([status])
  @@index([customerId])
  @@index([assignedAgentId])
  @@map("orders")
}

// Append-only. Rows are never updated or deleted — this IS the immutable tracking timeline.
model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OrderStatus
  note        String?
  actorId     String?
  actor       User?       @relation("ActorUser", fields: [actorId], references: [id])
  actorRole   Role?
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}
